# The FileBrowser Quantum release this addin ships. Nothing of it is in this repo: tools/fetch-upstream.sh downloads the
# binaries and the licence at build time and refuses them unless they match these hashes. The Upstream workflow
# (tools/upstream-check.sh) opens a pull request that moves these lines to a newer stable release.
FB_REPO=gtsteffaniak/filebrowser
FB_TAG=v2.0.2-stable
FB_SHA256_ARMV7=1033a02e03e2203ca0ab3c430bda7f2d931250ba4cb7ee28cb3801f827496af2
FB_SHA256_ARM64=03eac074efc1b0ef3cb39882c04eeee26027049d261b6b6706650d4ac2d8e21c
FB_SHA256_LICENSE=47ce67778fa9640ab20c2414ab2d073430099bbbf6de163f8d215d3abc4a171c
